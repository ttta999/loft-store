{
  "compilerOptions": {
    "target": "es2023", "lib": ["ES2023", "DOM"], "module": "esnext",
    "types": ["node"], "skipLibCheck": true, "moduleResolution": "bundler",
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "noEmit": true,
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["api", "server"]
}
